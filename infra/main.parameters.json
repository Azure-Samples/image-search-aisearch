{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "searchServiceLocation": {
      "value": "${AZURE_SEARCH_SERVICE_LOCATION}"
    },
    "searchServiceName": {
      "value": "${AZURE_SEARCH_SERVICE}"
    },
    "searchIndexName": {
      "value": "${AZURE_SEARCH_INDEX=image-embedding-index}"
    },
    "searchServiceResourceGroupName": {
      "value": "${AZURE_SEARCH_SERVICE_RESOURCE_GROUP}"
    },
    "searchServiceSkuName": {
      "value": "${AZURE_SEARCH_SERVICE_SKU=standard}"
    },
    "semanticSearchSkuName": {
      "value": "${AZURE_SEARCH_SEMANTIC_SEARCH_SKU=free}"
    },
    "storageLocation": {
      "value": "${AZURE_STORAGE_ACCOUNT_LOCATION}"
    },
    "storageResourceGroupName": {
      "value": "${AZURE_STORAGE_ACCOUNT_RESOURCE_GROUP}"
    },
    "storageAccountName": {
      "value": "${AZURE_STORAGE_ACCOUNT}"
    },
    "apiServiceLocation": {
      "value": "${AZURE_API_SERVICE_LOCATION}"
    },
    "apiServiceResourceGroupName": {
      "value": "${AZURE_API_SERVICE_RESOURCE_GROUP}"
    },
    "logAnalyticsName": {
      "value": "${AZURE_LOG_ANALYTICS}"
    },
    "applicationInsightsName": {
      "value": "${AZURE_APPINSIGHTS}"
    },
    "computerVisionAccountName": {
      "value": "${AZURE_COMPUTER_VISION_ACCOUNT}"
    },
    "computerVisionResourceGroupName": {
      "value": "${AZURE_COMPUTER_VISION_RESOURCE_GROUP}"
    },
    "computerVisionLocation": {
      "value": "${AZURE_COMPUTER_VISION_LOCATION}"
    },
    "computerVisionSkuName": {
      "value": "${AZURE_COMPUTER_VISION_SKU_NAME=S0}"
    },
    "acaExists": {
      "value": "${SERVICE_ACA_RESOURCE_EXISTS=false}"
    },
    "mcpExists": {
      "value": "${SERVICE_MCP_RESOURCE_EXISTS=false}"
    },
    "openAiServiceName": {
      "value": "${AZURE_OPENAI_SERVICE}"
    },
    "openAiLocation": {
      "value": "${AZURE_OPENAI_LOCATION}"
    },
    "openAiResourceGroupName": {
      "value": "${AZURE_OPENAI_RESOURCE_GROUP}"
    },
    "openAiSkuName": {
      "value": "${AZURE_OPENAI_SKU_NAME=S0}"
    },
    "chatCompletionModelName": {
      "value": "${AZURE_OPENAI_CHAT_MODEL=gpt-4.1-mini}"
    },
    "chatCompletionDeploymentName": {
      "value": "${AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini}"
    },
    "chatCompletionModelVersion": {
      "value": "${AZURE_OPENAI_CHAT_MODEL_VERSION=2025-04-14}"
    },
    "chatCompletionDeploymentCapacity": {
      "value": "${AZURE_OPENAI_CHAT_DEPLOYMENT_CAPACITY=100}"
    },
    "runningOnGh": {
      "value": "${GITHUB_ACTIONS}"
    }
  }
}
